SUPABASE_URL=https://seu-projeto-orchestrator-ai.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PROJECT_SUPABASE_MCP_ENABLED=true
PROJECT_SUPABASE_PROJECT_REF=abcdefghijklmnop
PROJECT_SUPABASE_ACCESS_TOKEN=

# Provedor de IA: 'cursor', 'claude' ou 'ollama'
AI_PROVIDER=ollama

# Anthropic (obrigatório quando AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Cursor (obrigatório quando AI_PROVIDER=cursor)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_CLI_PATH=

# Ollama local (obrigatório quando AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

ENVIRONMENT=development

TARGET_REPO=Britojp/auto-zap
REPO_PATH=/Users/joaopedro/Documents/auto-zap
BRANCH_BASE=develop

GITHUB_TOKEN=
GH_CLI_PATH=

REDIS_URL=redis://localhost:6379

POLL_INTERVAL_MS=60000
TASK_TIMEOUT_MS=5400000
STALE_LOCK_MINUTES=120
MAX_RETRIES=2
BRANCH_PREFIX=agent/task

WORKER_ID=worker-local-1
PORT=3000
